{
  "name": "chaogou-mall-search",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "潮购商城商品搜索：Node + MySQL（ngram 全文索引）+ 前端防抖与请求竞态处理",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "db:setup": "node server/setup-db.js",
    "test": "vitest run",
    "test:unit": "vitest run --exclude tests/db-integration.test.js",
    "test:integration": "vitest run tests/db-integration.test.js",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{js,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{js,json,css,md}\"",
    "prepare": "husky"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "concurrently": "^9.1.0",
    "eslint": "^9.17.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "dotenv": "^18.0.10",
    "mysql2": "^3.24.6"
  }
}
